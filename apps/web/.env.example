# Copy to .env.local for local overrides. Vite exposes VITE_* vars to the browser,
# so never put a secret here.

# Backend origin the dev server proxies /api and /v1 to (default http://localhost:8000).
# VITE_API_PROXY=http://localhost:8000

# Absolute API origin for builds served from a different host than the API.
# VITE_API_BASE_URL=

# 1 = use the in-browser mock for the /v1 login, onboarding and profile endpoints
# (src/api/mock.ts) until the WP1/WP2/WP6 backends are merged. Mock OTP code: 123456.
# VITE_USE_MOCKS=1
