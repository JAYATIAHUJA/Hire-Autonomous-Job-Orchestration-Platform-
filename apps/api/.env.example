DATABASE_URL=sqlite:///./hire.db
GITHUB_API_BASE=https://api.github.com
GITHUB_CONCURRENCY=8
# Server-side GitHub token for background PoW runs when the user has not linked GitHub.
# A fine-grained token with public read-only access is enough. Empty = unauthenticated
# (60 requests/hour, no GraphQL contribution totals).
GITHUB_APP_TOKEN=
# Back-off: waits GitHub asks for (Retry-After / X-RateLimit-Reset) up to this many
# seconds are slept through; longer ones fail the run as rate-limited.
GITHUB_MAX_RETRIES=3
GITHUB_MAX_BACKOFF_SECONDS=60
GITHUB_ETAG_CACHE_SIZE=4096
# Analysis depth with a personal access token (5,000 requests/hour)
FULL_MAX_REPOS=20
FULL_COMMITS_PER_REPO=40
FULL_EXTERNAL_PRS=30
# Analysis depth without a token (60 requests/hour)
LIMITED_MAX_REPOS=3
LIMITED_COMMITS_PER_REPO=8
LIMITED_EXTERNAL_PRS=5
# Proof-of-Work background runs (picked up by python -m app.worker).
POW_POLL_SECONDS=2
# A run still "running" after this many seconds is presumed dead and marked failed.
POW_STALE_RUN_SECONDS=1800
CORS_ORIGINS=["http://localhost:5173"]
# Signs swipe-right consent receipts (HMAC-SHA256). Required, at least 32 chars. Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
CONSENT_SIGNING_SECRET=
# Set false to use only the built-in fixtures (no RemoteOK calls).
LIVE_FEEDS_ENABLED=true
# Background recruiter-mailbox reader (Objective 3). Use an app password, not your login password.
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Whose board this mailbox's replies may move: an account id (12 or account:12) or the
# account's email. Required when IMAP is on.
IMAP_CANDIDATE_REF=
IMAP_MAILBOX=INBOX
IMAP_USE_SSL=true
IMAP_SEARCH=UNSEEN
IMAP_POLL_SECONDS=300
IMAP_FETCH_LIMIT=25
# --- Accounts and login (WP1, docs/adr/010-auth-sessions.md) ---
# "dev" enables POST /v1/auth/dev-login and prints OTP codes to the API log. Anything else
# (the default is "prod") turns both off. Never set dev on a deployed server.
ENV=dev
# Fernet key that encrypts stored GitHub OAuth tokens. Required for GitHub login. Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
SESSION_TTL_DAYS=30
# Keep true: browsers accept Secure cookies on http://localhost.
SESSION_COOKIE_SECURE=true
# Public base URL the OAuth providers redirect back to; register <base>/v1/auth/<provider>/callback.
AUTH_CALLBACK_BASE_URL=http://localhost:8100
# Where the browser lands after an OAuth login.
WEB_APP_URL=http://localhost:5173
# GitHub OAuth app (github.com/settings/developers). Scopes requested: read:user user:email.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Google OAuth client (console.cloud.google.com, Credentials). Scopes: openid email profile.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Accounts with these verified emails get the admin role, e.g. ["you@example.com"].
ADMIN_EMAILS=[]
# Login-code delivery: console (ENV=dev only) or smtp. Empty = console in dev, smtp otherwise.
OTP_SENDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Object store for uploaded resumes (ADR-009: S3 API only; SeaweedFS in dev, AWS S3 ap-south-1 in prod).
# Resume upload returns 503 until S3_BUCKET is set.
S3_ENDPOINT=http://127.0.0.1:58333
S3_BUCKET=hire-dev
S3_ACCESS_KEY=hire
S3_SECRET_KEY=
S3_REGION=ap-south-1
# Anthropic API key for resume parsing (app/llm). Never commit a real key.
ANTHROPIC_API_KEY=
# Model id for every LLM call. Change it here, never at a call site.
LLM_MODEL=claude-opus-5-5
# Effort: low | medium | high | xhigh | max (claude-opus-5-5 defaults to medium).
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120
# SDK retries on 408/409/429/5xx and connection errors, with backoff.
LLM_MAX_RETRIES=3
# Server-side refusal fallback (beta header). Set false if a proxy rejects it.
LLM_REFUSAL_FALLBACK=true
