        "sha": "361cfbccd4e5c1f6e4fcabfea2c0338e63e7d1b1",
        "filename": "src/hooks/useSearch.ts",
        "status": "modified",
        "additions": 40,
        "deletions": 0,
        "changes": 40,
        "patch": "@@ -1,0 +1,9 @@\n+import { useEffect, useState } from 'react'\n+export function useSearch(q: string) {\n+  const [debounced, setDebounced] = useState(q)\n+  useEffect(() => {\n+    const t = setTimeout(() => setDebounced(q), 250)\n+    return () => clearTimeout(t)\n+  }, [q])\n+  return debounced\n+}"
      }
    ]
