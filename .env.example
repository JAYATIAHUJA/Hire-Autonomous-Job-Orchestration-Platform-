# Hire — local environment.
#
# Copy to `.env` next to compose.yml (or just run `python scripts/dev.py`: it creates .env
# and fills in the generated secrets for you; it never overwrites values you set).
# Never commit .env.
#
# After editing, restart the API and worker:  docker compose up -d api worker


# ===========================================================================================
# 1. GENERATED — scripts/dev.py fills these in. Leave them alone unless you know why.
# ===========================================================================================

# Signs the consent receipt written on every right swipe. 32+ characters; the API refuses
# to start without it. Changing it invalidates verification of older receipts.
CONSENT_SIGNING_SECRET=

# Fernet key that encrypts the GitHub tokens users paste into their profile. Without it
# users can still save their GitHub username, but not a token.
# python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
TOKEN_ENCRYPTION_KEY=

# Local S3 (SeaweedFS) for resumes and screenshots.
S3_ACCESS_KEY=hire
S3_SECRET_KEY=

# Browser computers (only with `python scripts/dev.py --computers`).
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=


# ===========================================================================================
# 2. NEEDED FOR THE FULL APP — add these yourself.
# ===========================================================================================

# --- Resume parsing (LLM) ------------------------------------------------------------------
# Any Anthropic-compatible endpoint. Defaults below are Z.ai GLM; for Claude, empty the base
# URL, set LLM_MODEL=claude-opus-5-5, LLM_EFFORT=medium, LLM_REFUSAL_FALLBACK=true.
# Without a key, resume upload answers 503 and onboarding lets you skip it.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
#   China mainland keys (bigmodel.cn): https://open.bigmodel.cn/api/anthropic
LLM_MODEL=glm-5.1
LLM_EFFORT=
LLM_REFUSAL_FALLBACK=false

# --- GitHub API token for Proof-of-Work analysis -------------------------------------------
# Sign-in is email-only; users give their own GitHub username and (optionally) their own
# token on their profile. This server token is the fallback for users who gave no token.
# It raises GitHub's limit from 60 to 5,000 requests/hour (without it, analysis covers only ~3 repos and runs out quickly).
# GitHub > Settings > Developer settings > Personal access tokens > Fine-grained,
# "Public repositories (read-only)", no extra permissions.
GITHUB_APP_TOKEN=


# ===========================================================================================
# 3. OPTIONAL
# ===========================================================================================

# --- Real email for login codes ------------------------------------------------------------
# Empty = dev mode: the 6-digit code is printed in the API log instead of emailed:
#   docker logs hire-api-1 2>&1 | findstr "DEV login code"
# Gmail: smtp.gmail.com, port 587, your address, and an App Password (not your login password).
OTP_SENDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Recruiter replies → Pipeline board ----------------------------------------------------
# Reads a mailbox every few minutes and moves cards when a recruiter replies.
# Gmail: imap.gmail.com and an App Password. IMAP_CANDIDATE_REF = the email you sign in with.
IMAP_ENABLED=false
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_CANDIDATE_REF=

# --- Live job feeds ------------------------------------------------------------------------
# true pulls real openings (RemoteOK) every 30 minutes. No key needed.
LIVE_FEEDS_ENABLED=false

# --- Browser computer limits (only with --computers) ---------------------------------------
# COMPUTER_MEMORY_BYTES=2147483648
# COMPUTER_RUNTIME=
